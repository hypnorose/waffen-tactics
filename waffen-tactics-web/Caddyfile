waffentactics.pl {
    # Automatyczny HTTPS (Let's Encrypt)
    
    # API backend (WSGI) - strip /api prefix
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy localhost:8000
    }
    
    # React app (frontend) - serve the verified production artifact directly.
    handle {
        root * /home/ubuntu/waffen-tactics-game/waffen-tactics-web/dist
        try_files {path} /index.html
        file_server
    }
    
    # Kompresja
    encode gzip
    
    # Logi
    log {
        output file /var/log/caddy/waffentactics.log
    }
}

www.waffentactics.pl {
    # Redirect www -> non-www
    redir https://waffentactics.pl{uri} permanent
}
