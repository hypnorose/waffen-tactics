VITE_DISCORD_CLIENT_ID=your_discord_client_id_here
VITE_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_API_URL=http://localhost:8000

# Backend CORS: production requires an explicit comma-separated allowlist.
# For local development only, set ALLOW_LOCAL_DEVELOPMENT_CORS=true.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_LOCAL_DEVELOPMENT_CORS=false
JWT_LEEWAY_SECONDS=5
JWT_EXPIRED_GRACE_SECONDS=600
