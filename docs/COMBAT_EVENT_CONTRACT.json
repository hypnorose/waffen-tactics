    {"type": "mana_update", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "current_mana"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "heal", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "post_hp"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "unit_heal", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "post_hp"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "shield_applied", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "amount", "post_shield"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "shield_broken", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "amount", "post_shield"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "damage_over_time_applied", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "effect_id", "damage", "expires_at"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "damage_over_time_tick", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "post_hp"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "damage_over_time_expired", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "effect_id", "post_hp"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "effect_applied", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "effect"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "effect_expired", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "effect_id"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "unit_stunned", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "effect_id"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "stat_buff", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "stat", "applied_delta"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "hp_regen", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "post_hp"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "regen_gain", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "post_hp_regen_per_sec"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "skill_cast", "origin": "core", "mapper": "map_branch", "reconstructor": "explicit_noop", "frontend": "case", "required_fields": ["type", "seq", "event_id"], "post_state": "none", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "passive_triggered", "origin": "core", "mapper": "map_branch", "reconstructor": "explicit_noop", "frontend": "case", "required_fields": ["type", "seq", "event_id"], "post_state": "none", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "formation_changed", "origin": "core", "mapper": "map_branch", "reconstructor": "state", "frontend": "case", "required_fields": ["type", "seq", "event_id", "unit_id", "previous_position", "new_position"], "post_state": "authoritative", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"},
    {"type": "gold_reward", "origin": "core", "mapper": "map_branch", "reconstructor": "explicit_noop", "frontend": "case", "required_fields": ["type", "seq", "event_id"], "post_state": "none", "ordering": "strict_seq", "dedupe": "event_id", "presentation": "combat_log"}
  ],
  "transport_error_contract": {
    "type": "error",
    "required_fields": ["type", "code", "message", "retriable"],
    "not_replayed_as_combat_event": true,
    "test_reference": "waffen-tactics-web/src/hooks/combat/__tests__/useCombatSSEBuffer.test.tsx"
  }
